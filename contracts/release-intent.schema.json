{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://release-control.arconath.com/contracts/release-intent.schema.json",
  "title": "Arconath release intent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "intent_id",
    "policy_id",
    "signer_identity",
    "issued_at",
    "expires_at",
    "source",
    "artifact",
    "rollback"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "intent_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,127}$"},
    "policy_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
    "signer_identity": {"const": "hermawan22"},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit_sha", "tree_sha"],
      "properties": {
        "repository": {"type": "string", "pattern": "^Arconath/[a-z0-9][a-z0-9-]{1,99}$"},
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "version"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[a-z0-9.-]+(?::[1-9][0-9]{0,4})?(?:/[a-z0-9][a-z0-9._-]*)+$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"}
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previous_digest", "reason"],
      "properties": {
        "previous_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "reason": {"type": "string", "minLength": 8, "maxLength": 512}
      }
    }
  }
}
