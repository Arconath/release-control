{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Arconath build evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "intent_id", "source", "artifact", "oci_archive_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "intent_id": {"type": "string"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit_sha", "tree_sha"],
      "properties": {
        "repository": {"type": "string"},
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest"],
      "properties": {
        "repository": {"type": "string"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "oci_archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
