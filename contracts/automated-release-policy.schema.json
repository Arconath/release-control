{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://release-control.arconath.com/contracts/automated-release-policy.schema.json",
  "title": "Arconath permanent automated release policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "authorization_mode",
    "human_signers_required",
    "human_reviewers_required",
    "manual_override",
    "control_plane",
    "allowed_routes",
    "required_checks",
    "required_evidence",
    "rollout"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "policy_id": {"const": "arconath-automated-release"},
    "authorization_mode": {"const": "machine-only"},
    "human_signers_required": {"const": false},
    "human_reviewers_required": {"const": false},
    "manual_override": {"const": false},
    "control_plane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "workflow_path",
        "ref",
        "runner_group",
        "runner_labels",
        "machine_signer_identity",
        "public_control_repository",
        "public_runner_allowed"
      ],
      "properties": {
        "repository": {"const": "Arconath/.github"},
        "workflow_path": {"const": ".github/workflows/release-control.yml"},
        "ref": {"const": "refs/heads/main"},
        "runner_group": {"const": "arconath-jit"},
        "runner_labels": {
          "type": "array",
          "const": ["self-hosted", "linux", "x64", "arconath-jit", "rootless-buildkit"]
        },
        "machine_signer_identity": {"const": "arconath-release-bot"},
        "public_control_repository": {"const": "Arconath/release-control"},
        "public_runner_allowed": {"const": false}
      }
    },
    "allowed_routes": {
      "type": "array",
      "const": [
        "releasepassport.com",
        "foundiqo.com",
        "loklyo.com",
        "boringkit.com",
        "abra.arconath.com",
        "aeliqo.com",
        "spatial.arconath.com",
        "labs.arconath.com",
        "peoplepassport.arconath.com",
        "agentdeck.arconath.com",
        "syviora.com"
      ]
    },
    "required_checks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    },
    "required_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provenance",
        "sbom",
        "artifact_signature",
        "machine_attestation_signature",
        "canary",
        "rollback",
        "backup_guard",
        "production_domain_guard"
      ],
      "properties": {
        "provenance": {"const": true},
        "sbom": {"const": true},
        "artifact_signature": {"const": true},
        "machine_attestation_signature": {"const": true},
        "canary": {"const": true},
        "rollback": {"const": true},
        "backup_guard": {"const": true},
        "production_domain_guard": {"const": true}
      }
    },
    "rollout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environments",
        "canary_required",
        "automatic_rollback_required",
        "external_backup_guard",
        "production_domain_guard",
        "backup_mode",
        "canary_abort_thresholds",
        "max_promotions_per_attestation",
        "cooldown_seconds",
        "max_attestation_age_seconds"
      ],
      "properties": {
        "environments": {
          "type": "array",
          "const": ["production"]
        },
        "canary_required": {"const": true},
        "automatic_rollback_required": {"const": true},
        "external_backup_guard": {"const": true},
        "production_domain_guard": {"const": true},
        "backup_mode": {"const": "local-only-no-off-host-dr"},
        "canary_abort_thresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["error_rate_percent_max", "p95_latency_ms_max", "restart_count_max"],
          "properties": {
            "error_rate_percent_max": {"const": 5.0},
            "p95_latency_ms_max": {"const": 2000},
            "restart_count_max": {"const": 3}
          }
        },
        "max_promotions_per_attestation": {"const": 1},
        "cooldown_seconds": {"type": "integer", "minimum": 60, "maximum": 3600},
        "max_attestation_age_seconds": {"type": "integer", "minimum": 60, "maximum": 900}
      }
    }
  }
}
