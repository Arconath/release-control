{
  "environments": {
    "promotion": {
      "can_admins_bypass": false,
      "protected_branches_only": true,
      "required_secrets": [],
      "required_reviewers": 0,
      "wait_timer_minutes": 0
    },
    "publication": {
      "can_admins_bypass": false,
      "protected_branches_only": true,
      "required_secrets": [
        "ARCONATH_REGISTRY_USERNAME",
        "ARCONATH_REGISTRY_PASSWORD"
      ],
      "required_reviewers": 0,
      "wait_timer_minutes": 0
    }
  },
  "main_protection": {
    "allow_deletions": false,
    "allow_force_pushes": false,
    "dismiss_stale_reviews": true,
    "enforce_admins": true,
    "linear_history": true,
    "required_approvals": 0,
    "required_checks": [
      "contracts and workflow policy"
    ],
    "require_code_owner_review": false,
    "require_last_push_approval": false,
    "require_signed_commits": true,
    "strict_checks": true
  },
  "release_governance": {
    "authorization_mode": "machine-only",
    "human_reviewers_required": false,
    "human_signers_required": false,
    "manual_override": false,
    "policy_id": "arconath-automated-release",
    "required_checks": [
      "contracts and workflow policy",
      "release-control machine attestation"
    ]
  },
  "repository": {
    "delete_branch_on_merge": true,
    "description": "Trusted source-to-digest release authority for Arconath products",
    "has_discussions": false,
    "has_issues": true,
    "has_projects": false,
    "has_wiki": false,
    "visibility": "public"
  },
  "required_repository_variables": {
    "ARCONATH_REGISTRY_HOST": "ghcr.io",
    "SOURCE_READER_APP_ID": "set-after-source-reader-app-is-created"
  },
  "schema_version": 1
}
