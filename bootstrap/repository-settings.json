{
  "environments": {
    "promotion": {
      "protected_branches_only": true,
      "required_secrets": [],
      "wait_timer_minutes": 0
    },
    "publication": {
      "protected_branches_only": true,
      "required_secrets": [
        "ARCONATH_REGISTRY_USERNAME",
        "ARCONATH_REGISTRY_PASSWORD"
      ],
      "wait_timer_minutes": 0
    }
  },
  "main_protection": {
    "allow_deletions": false,
    "allow_force_pushes": false,
    "dismiss_stale_reviews": true,
    "enforce_admins": true,
    "linear_history": true,
    "required_approvals": 2,
    "required_checks": [
      "contracts and workflow policy"
    ],
    "require_code_owner_review": true,
    "require_last_push_approval": true,
    "require_signed_commits": true,
    "strict_checks": true
  },
  "repository": {
    "delete_branch_on_merge": true,
    "description": "Trusted source-to-digest release authority for Arconath products",
    "has_discussions": false,
    "has_issues": true,
    "has_projects": false,
    "has_wiki": false,
    "visibility": "public"
  },
  "required_repository_variables": {
    "ARCONATH_REGISTRY_HOST": "registry.arconath.internal",
    "SOURCE_READER_APP_ID": "set-after-source-reader-app-is-created"
  },
  "schema_version": 1
}
